{
  "name": "home-vault-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "npm run build && mocha --timeout 20000 \"lib/test/**/*.test.js\"",
    "test:rules": "firebase emulators:exec --only firestore,storage,auth --project demo-homevault \"npm run test\"",
    "serve": "npm run build && firebase emulators:start",
    "deploy": "firebase deploy --only functions"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/archiver": "^6.0.4",
    "@types/luxon": "^3.7.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "firebase": "^12.19.0",
    "mocha": "^12.0.3",
    "typescript": "~5.9"
  }
}
